#!/bin/sh
# Pre-commit: fast checks for the stacks the commit touches.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip once:               git commit --no-verify   (or SKIP_HOOKS=1)
#
# A ~seconds tripwire, not a substitute for CI: `.github/workflows/ci.yml` runs
# the full suite (build, xUnit, image build, Trivy, boot smoke) on every PR.
# POSIX sh on purpose: git invokes the shebang directly, and sh exists
# everywhere git does (including git-for-windows).
set -eu

[ "${SKIP_HOOKS:-0}" = "1" ] && exit 0

# Checks run against the WORKING TREE, not the staged snapshot — with partial
# staging (git add -p) the hook can pass while the staged content alone would
# not build. Acceptable for a tripwire; CI checks the real tree. D included:
# deleting a .cs/.csproj can break references just as well.
staged=$(git diff --cached --name-only --diff-filter=ACMRD)

fail() { echo "pre-commit: FAILED ($1) — fix or use --no-verify." >&2; exit 1; }

if echo "$staged" | grep -qE '\.slnx?$|\.cs(proj)?$|packages\.lock\.json$'; then
  echo "pre-commit: .NET build (Release, no-restore)..."
  dotnet build src/server/Collectify.slnx --configuration Release --nologo -v q \
    || fail ".NET build"
fi

if echo "$staged" | grep -q '^src/client/'; then
  echo "pre-commit: client typecheck + build..."
  (cd src/client && npm run --silent build) || fail "client build"
fi

exit 0
