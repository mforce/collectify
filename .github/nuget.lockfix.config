<?xml version="1.0" encoding="utf-8"?>
<!-- Trusted restore config for the dependabot-lockfix workflow. Passed via
     dotnet restore's configfile option so restore ignores any nuget.config on
     the PR branch: exactly one source, nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
