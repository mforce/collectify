# IDE / OS
.idea/
.vscode/
.DS_Store

# Env
.env
.env.local

# .NET
bin/
obj/
*.user
src/server/Collectify.Api/appsettings.Development.json


# Node
node_modules/
src/client/dist/
*.tsbuildinfo

# Local DB / data
data/
*.db
*.db-shm
*.db-wal


# Graphify — commit graph.json / GRAPH_REPORT.md / graph.html / manifest.json
# so a fresh checkout starts with the map. The entries below are local-only.

# Machine-local: absolute interpreter + scan-root paths, differ per developer
graphify-out/.graphify_python
graphify-out/.graphify_root

# Local token-cost tracker
graphify-out/cost.json

# Extraction cache: regenerable, ~8MB, churns every run and is pinned to the
# installed graphify version. Drop the next two lines to trade repo size for
# faster first builds.
graphify-out/cache/

# graphify dated backup snapshots (regenerable on every update)
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Ad-hoc review artifacts
architecture-review-collectify.html

# graphify working artifacts (regenerable; only the curated graph set is committed)
graphify-out/.graphify_analysis.json
graphify-out/.graphify_labels.json.sig

# Driver scratch (feature-driver runbooks/notes/handouts) — not part of any PR
.driver/
